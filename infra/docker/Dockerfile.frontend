# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# Stage 2: Serve
FROM nginx:alpine

# Store build output in staging directory (not the final serve path)
COPY --from=builder /app/dist /app/dist-new

COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY infra/docker/docker-entrypoint-frontend.sh /docker-entrypoint-frontend.sh
RUN chmod +x /docker-entrypoint-frontend.sh

# Ensure serve directory and assets subdirectory exist
RUN mkdir -p /usr/share/nginx/html/assets

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint-frontend.sh"]
